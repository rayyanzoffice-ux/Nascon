# Required at startup, supplied by your NaSCon team slip. Never commit the real value.
DAY1_SALT=
# Day 2 signing input, supplied at runtime. Never commit its actual value.
DAY2_SALT=
# Optional override for local demo auth. Change for any non-demo deployment.
# Optional JWT signing secret. Leave blank to use the runtime's generated default.
JWT_SECRET=
# Docker Compose supplies the container URLs below automatically. These values
# are only needed when running the API or worker outside Compose.
DATABASE_URL=postgresql://nascon:nascon_local@localhost:5432/nascon
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
MINIO_ENDPOINT=localhost:9000
